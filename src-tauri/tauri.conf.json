{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Балтийские пути",
  "version": "1.2.41",
  "identifier": "com.rawdex.balticroads",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Балтийские пути",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "backgroundColor": "#101a1b",
        "useHttpsScheme": true,
        "zoomHotkeysEnabled": false,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Rawdex",
    "category": "StrategyGame",
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "languages": ["Russian", "English"]
      }
    }
  }
}
